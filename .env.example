# ============================================================
# CriaBook — variáveis de ambiente (copie para .env.local)
# NUNCA commite .env.local — ele está no .gitignore.
# ============================================================

# --- Banco (Neon) ---
DATABASE_URL=                 # connection string POOLED (-pooler) — runtime
DATABASE_URL_UNPOOLED=        # connection string DIRECT — migrations

# --- Better Auth ---
BETTER_AUTH_SECRET=           # gere: openssl rand -base64 32
BETTER_AUTH_URL=              # URL pública (ex.: https://criabook.vercel.app)
# OAuth opcional:
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- IA (Claude) — Fase 3+ ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_MAIN=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# --- Embeddings (Voyage AI) — Fase 3 (dedup semântico de keywords) ---
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5-lite   # opcional; default no código (1024 dims)

# --- IA de imagem (Kie.ai) ---
KIE_AI_API_KEY=
KIE_AI_BASE_URL=https://api.kie.ai
# KIE_DEFAULT_MODEL=google/imagen4-ultra   # opcional

# --- Storage (Vercel Blob) — Fase 8 ---
BLOB_READ_WRITE_TOKEN=

# --- Pagamentos / créditos — Fase 2 ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Jobs longos — Fase 11 ---
TRIGGER_SECRET_KEY=

# --- Precificação de créditos (ajustável) — Fase 2 ---
CREDITS_PER_1K_INPUT_TOKENS=1
CREDITS_PER_1K_OUTPUT_TOKENS=5
CREDITS_PER_IMAGE=20
